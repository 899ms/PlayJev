{
  "name": "playjev",
  "private": true,
  "version": "0.1.0",
  "description": "Visually build Jev (TypeSafe System One) API inputs: state + typed questions, with lint, playground and AI-assisted generation.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node server/proxy.mjs",
    "dev": "npm run dev -w @playjev/web",
    "build": "npm run build -w @playjev/web",
    "typecheck": "tsc -p packages/core && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "proxy": "node server/proxy.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "tw-animate-css": "^1.4.0"
  }
}
